{
  "manifest_version": 3,
  "name": "IG Bridge (MediaScanner)",
  "version": "1.0.0",
  "description": "Выполняет запросы чтения Instagram для сервера MediaScanner из этого профиля Chrome.",
  "minimum_chrome_version": "116",
  "permissions": ["cookies", "alarms", "storage", "notifications", "background", "scripting", "tabs"],
  "host_permissions": ["https://*.instagram.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://www.instagram.com/*"], "js": ["content/capture.js"], "world": "MAIN", "run_at": "document_start" },
    { "matches": ["https://www.instagram.com/*"], "js": ["content/relay.js"], "run_at": "document_start" }
  ],
  "action": { "default_popup": "popup.html", "default_title": "IG Bridge" },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
