{
  "manifest_version": 3,
  "name": "TikTok Bridge (MediaScanner)",
  "version": "1.0.3",
  "description": "Читает ленты целевых аккаунтов TikTok для MediaScanner из этого профиля Chrome.",
  "minimum_chrome_version": "116",
  "permissions": ["alarms", "storage", "tabs", "scripting", "cookies", "notifications"],
  "host_permissions": [
    "https://www.tiktok.com/*",
    "https://app.mediascanner.kz/*",
    "https://mediascanner.robosoft.kz/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["content/extract.js", "content/capture.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "TikTok Bridge" },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
